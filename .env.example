# ================================================
# IBVAP — Environment Configuration
# ================================================
# Copy this file to .env and fill in values.
# NEVER commit .env to version control.
# ================================================

# --- Authentication ---
# Bootstrap admin email (created on first run if no users exist)
ADMIN_EMAIL=admin@ibvap.local

# Bootstrap admin password (CHANGE ME — required for ensure_admin.py / reset_admin_password.py)
ADMIN_PASSWORD=CHANGE_ME

# JWT signing key (generate a random 64+ character string for production)
SECRET_KEY=CHANGE_ME_GENERATE_A_LONG_RANDOM_SECRET

# JWT token lifetime in minutes (default: 60)
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Development-only bypass: accept the hardcoded "dev-bypass-token".
# Ignored entirely when APP_ENV=production (or on Render).
DEV_AUTH_BYPASS=false

# Screening mode (evaluator demo): bypass login page, auto-authenticate as admin
# Set SCREENING_MODE=true on the server AND VITE_SCREENING_MODE=true in frontend/.env.local
# When enabled, the evaluator sees the dashboard immediately — no credentials required.
SCREENING_MODE=false

# Comma-separated CORS origins
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# --- Database (SQLite — the project's database; NO PostgreSQL) ---
# Local/dev file DB. On Render production use an absolute path on the disk:
#   DATABASE_URL=sqlite+aiosqlite:////var/data/ibvap.db
DATABASE_URL=sqlite+aiosqlite:///./ibvap.db

# --- Store-and-Forward Synchronization ---
# Enable background sync to central server (default: false for standalone demo)
SYNC_ENABLED=false

# Sync interval in seconds (default: 10)
SYNC_INTERVAL_SEC=10

# Max items per sync pass (default: 20)
SYNC_BATCH_SIZE=20

# HTTP timeout for central API calls in seconds (default: 15)
SYNC_REQUEST_TIMEOUT_SEC=15

# Max retry attempts before marking FAILED (default: 5)
SYNC_MAX_RETRIES=5

# Base seconds for exponential backoff (default: 2.0)
SYNC_BACKOFF_BASE_SEC=2.0

# Max backoff cap in seconds (default: 60.0)
SYNC_BACKOFF_MAX_SEC=60.0

# Delete SYNCED items older than N days (default: 30)
SYNC_CLEANUP_DAYS=30

# Central IBVAP server URL (leave empty for standalone mode)
CENTRAL_API_URL=

# API key for central server authentication (optional)
CENTRAL_API_KEY=

# --- Network Health Monitoring ---
NETWORK_HEALTH_ENABLED=true
NETWORK_HEALTH_INTERVAL_SEC=10
NETWORK_HEALTH_TIMEOUT_SEC=5
NETWORK_DEGRADED_LATENCY_MS=1000
NETWORK_FAILURE_THRESHOLD=3
NETWORK_RECOVERY_THRESHOLD=2
NETWORK_HEALTH_WINDOW_SIZE=20

# --- Edge Node Identity & Security ---
# Unique identifier for this Edge node (e.g. "BOP-EDGE-001")
EDGE_NODE_ID=

# Secret for Edge node authentication (never commit, never log)
EDGE_NODE_SECRET=

# Edge JWT token lifetime in seconds (default: 300)
EDGE_TOKEN_TTL_SECONDS=300

# Separate signing key for Edge JWTs (distinct from SECRET_KEY)
EDGE_TOKEN_SECRET=

# JWT issuer claim for Edge tokens (default: ibvap-edge)
EDGE_TOKEN_ISSUER=ibvap-edge

# Throttle for last_seen_at updates in seconds (default: 60)
EDGE_LAST_SEEN_UPDATE_SECONDS=60

# Enable TLS certificate verification (default: true)
CENTRAL_VERIFY_TLS=true

# Optional CA certificate bundle path for TLS
CENTRAL_CA_BUNDLE=

# Maximum evidence file upload size in MB (default: 10)
MAX_EVIDENCE_UPLOAD_MB=10

# Max auth failures per window before rate limiting (default: 5)
EDGE_AUTH_RATE_LIMIT_MAX=5

# Rate limit window in seconds (default: 300)
EDGE_AUTH_RATE_LIMIT_WINDOW_SEC=300

# --- Blockchain / Trust Layer ---
BLOCKCHAIN_ENABLED=false

# --- Server ---
HOST=0.0.0.0
PORT=8000
DEBUG=false

# Deployment environment: set to "production" on real deployments.
# Enables strict startup validation (required env, mandatory persistent
# database (SQLite), screening/bypass lockdown, persistent EVIDENCE_DIR).
APP_ENV=development

# Evidence storage directory. Must be an absolute path on persistent
# storage in production (e.g. /var/data/evidence on Render disk).
EVIDENCE_DIR=

# FastAPI base URL used by the Express BFF. On Render this MUST be the actual
# URL assigned to the ibvap-ai service (copy it from the Render dashboard).
AI_SERVICE_URL=http://localhost:8000
