# ================================================
# IBVAP AI Service Configuration
# ================================================
# Copy this to .env in the project root and customize.
# This file is a reference for backend-specific variables.
# ================================================

# --- Video Source ---
# video | rtsp | webcam
VIDEO_SOURCE_TYPE=video
VIDEO_SOURCE=./data/surveillance_test.mp4

# --- YOLO Model ---
# yolov8n.pt (nano), yolov8s.pt (small), yolov8m.pt (medium)
MODEL_PATH=yolov8n.pt

# --- Detection Thresholds ---
CONFIDENCE_THRESHOLD=0.50
IOU_THRESHOLD=0.45
IMAGE_SIZE=640

# --- Inference ---
INFERENCE_FPS=10
# auto | cpu | cuda
DEVICE=auto

# --- Service ---
AI_SERVICE_HOST=0.0.0.0
AI_SERVICE_PORT=8000
